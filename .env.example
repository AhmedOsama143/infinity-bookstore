# =============================================================================
# Infinity Bookstore — required environment variables
# =============================================================================
# Copy this file to `.env.local` and fill in the real values. Never commit
# the populated `.env.local` — it's gitignored.
#
# Vercel production values live under Project Settings → Environment
# Variables. Keep this file in sync with that list — if you add a new var,
# add it here AND mirror to Vercel.
# -----------------------------------------------------------------------------


# ---------- Supabase (server + browser) ---------------------------------------

# Browser-facing — safe to expose. Found in Supabase dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...your-anon-key

# Server-only — bypasses RLS. Used by `lib/supabase/admin.ts` for trusted writes.
# NEVER expose this to the client. NEVER commit this. If it leaks, rotate immediately.
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key


# ---------- Fawry payment gateway (server-only) -------------------------------

# Merchant code is public-ish (Fawry's plugin loads it client-side) but the
# secure key is the load-bearing crypto secret for every signed request and
# webhook verification. Server-only.
FAWRY_MERCHANT_CODE=your-merchant-code
FAWRY_SECURE_KEY=your-secure-key

# 'staging' (https://atfawrystaging.com) or 'production' (https://atfawry.com).
# Controls which Fawry endpoint the lib/fawry/client builds requests against,
# and which plugin JS URL the checkout-view loads.
FAWRY_ENV=staging

# Optional: per-request webhook URL override. If unset, Fawry uses the
# dashboard-configured URL. Recommended to set this so the integration is
# self-contained.
FAWRY_WEBHOOK_URL=https://your-domain.com/api/fawry/webhook

# Optional: customer-facing return URL after the popup closes. Defaults to
# `${origin}/checkout/result` when unset.
FAWRY_RETURN_URL=


# ---------- Rate limiting (Upstash Redis) — production ------------------------

# Used by lib/rate-limit.ts to bucket Fawry webhook traffic by IP. The limiter
# FAILS OPEN if these are unset, so the local dev environment doesn't need them
# (you'll see a warn log on every webhook).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=


# ---------- Cron auth ---------------------------------------------------------

# /api/cron/expire-orders requires this in the Authorization: Bearer <…> header.
# Vercel Cron sends this automatically when crons[] is configured in vercel.json
# AND CRON_SECRET is set in the Vercel project's env vars. Local cron testing:
# `curl -H "Authorization: Bearer $CRON_SECRET" http://localhost:3000/api/cron/expire-orders`.
CRON_SECRET=generate-a-32-char-random-string


# ---------- Email (lib/email.ts) ----------------------------------------------

# Used for order-status notifications. Configure based on your provider —
# whichever lib/email.ts targets.
ADMIN_EMAIL=admin@your-domain.com


# ---------- Analytics (optional) ----------------------------------------------

# Google Tag Manager container ID. Leave empty to skip GTM in dev/staging.
# When unset the <script> isn't rendered at all — no dataLayer pollution.
NEXT_PUBLIC_GTM_ID=
